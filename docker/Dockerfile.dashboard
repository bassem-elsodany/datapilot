# Simple development server for React dashboard
FROM node:20-alpine

# Install build dependencies
RUN apk add --no-cache python3 make g++

# Set working directory
WORKDIR /app

# Copy package files
COPY dashboard/package*.json ./

# Drop Electron-desktop-only packages before installing: this image only ever runs
# the Vite web dev server, never the Electron shell, and none of these are imported
# from any web-reachable source path. Electron's binary download and keytar's native
# build are otherwise the dominant cost of this install (especially under QEMU
# emulation for non-native architectures) despite being completely unused here.
RUN npm pkg delete dependencies.keytar dependencies.electron-store \
    devDependencies.electron devDependencies.electron-builder "devDependencies[@electron/asar]"

# Install all dependencies (including dev dependencies for build)
RUN npm install

# Copy source code
COPY dashboard/ ./

# Create environment file from template if it doesn't exist
RUN if [ ! -f .env ]; then cp env.example .env; fi

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

# Start development server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "80"]
